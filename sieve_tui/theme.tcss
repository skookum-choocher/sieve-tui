/* Noctus v2 palette applied to Textual primitives.
   Base stone grays with amber + acid green accents.

   IMPORTANT: We use *namespaced* variables ($noctus-*) so we don't collide
   with Textual's reserved CSS variables ($panel, $surface, etc.) which
   the framework uses in its own internal stylesheet in ways that break
   when overridden as plain colors (e.g. their `hatch: right $panel;` rule
   requires $panel to carry shape info we can't supply via CSS). */

$noctus-bg:        #1D1D1D;   /* near black — main background */
$noctus-surface:   #3E3E3E;   /* charcoal — secondary bg, inputs */
$noctus-panel:     #5C5C5C;   /* dark gray — borders, dim */
$noctus-fg:        #A5A5A5;   /* light gray — default text */
$noctus-fg-bright: #F5F5F5;   /* near white — emphasis */
$noctus-amber:     #E0A810;   /* hot amber — focus, accent */
$noctus-gold:      #D4A54E;   /* burnished gold — titles */
$noctus-acid:      #7A8C15;   /* acid green — active mode */
$noctus-green:     #3A8A3A;   /* forest green — success */
$noctus-terra:     #C75A43;   /* terra cotta — error */

Screen {
    background: $noctus-bg;
    color: $noctus-fg;
}

Header {
    background: $noctus-surface;
    color: $noctus-gold;
}

Footer {
    background: $noctus-surface;
    color: $noctus-fg;
}

.title {
    color: $noctus-gold;
    text-style: bold;
}

.hint {
    color: $noctus-panel;
    text-style: italic;
}

Button {
    background: $noctus-surface;
    color: $noctus-fg;
    border: tall $noctus-panel;
}

Button:hover {
    background: $noctus-panel;
}

Button:focus, Button.-primary {
    background: $noctus-amber 30%;
    color: $noctus-fg-bright;
    border: tall $noctus-amber;
}

Input {
    background: $noctus-surface;
    color: $noctus-fg;
    border: tall $noctus-panel;
}

Input:focus {
    border: tall $noctus-amber;
}

Tree {
    background: $noctus-bg;
    color: $noctus-fg;
}

Tree > .tree--cursor {
    background: $noctus-amber 30%;
    color: $noctus-fg-bright;
}

Select {
    background: $noctus-surface;
    color: $noctus-fg;
}

.cmdinput-paren {
    background: $noctus-surface;
    color: $noctus-acid;
    text-style: bold;
    padding: 1 1;
    width: auto;
}

CmdInput {
    height: 3;
}

CmdInput Input {
    width: 1fr;
}

#start-buttons Button {
    width: 30;
    margin: 1 2;
}

#start-buttons {
    align: center middle;
    height: auto;
}

.field-row {
    height: auto;
    margin: 0 0 1 0;
}

.field-row Label {
    width: 24;
    padding: 1 1;
    color: $noctus-gold;
}

.field-row Input, .field-row CmdInput, .field-row Select {
    width: 1fr;
}

#rule-tree {
    height: 1fr;
    border: tall $noctus-panel;
    padding: 1 2;
}

#rule-actions {
    height: auto;
    align: center middle;
}

#rule-actions Button {
    margin: 0 1;
}

RuleFormScreen {
    align: center middle;
}

#rule-form {
    width: 80;
    height: auto;
    max-height: 90%;
    border: thick $noctus-amber;
    background: $noctus-surface;
    padding: 2 3;
}
